<Application x:Class="Afterglow.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="WindowBrush" Color="#E9E6E4"/><SolidColorBrush x:Key="PanelBrush" Color="#EFFFFFFF"/><SolidColorBrush x:Key="SidebarBrush" Color="#CDEFECEB"/><SolidColorBrush x:Key="SurfaceBrush" Color="#C4FFFFFF"/><SolidColorBrush x:Key="TextBrush" Color="#282326"/><SolidColorBrush x:Key="MutedBrush" Color="#80767B"/><SolidColorBrush x:Key="FaintBrush" Color="#A3989F"/><SolidColorBrush x:Key="StrokeBrush" Color="#26877B81"/><SolidColorBrush x:Key="SelectionBrush" Color="#1AFA2D48"/><SolidColorBrush x:Key="AccentBrush" Color="#FA2D48"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Padding" Value="13,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderThickness" Value="1"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrafficLight" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#22000000" StrokeThickness=".6"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,8"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="7" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="10"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,8,28,8" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource PanelBrush}" CornerRadius="7" MinWidth="190" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderPart" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="3" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,9,0,17"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Height" Value="17"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderPart}" Command="Slider.DecreaseLarge" Background="{DynamicResource AccentBrush}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#3385757C" StrokeThickness=".8"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity=".12"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderPart}" Command="Slider.IncreaseLarge" Background="{DynamicResource StrokeBrush}"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="4" CornerRadius="2" Background="{DynamicResource FaintBrush}" Opacity=".35"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
