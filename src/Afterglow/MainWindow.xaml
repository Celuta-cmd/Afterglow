<Window x:Class="Afterglow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Afterglow" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Afterglow · YouTube Music wallpapers" Icon="afterglow.ico" Width="1380" Height="880" MinWidth="1100" MinHeight="760" WindowStyle="None" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14"/></shell:WindowChrome.WindowChrome>
 <Border CornerRadius="14" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Image x:Name="Atmosphere" Stretch="UniformToFill" Opacity=".13" IsHitTestVisible="False"/>
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
    <Grid Margin="20,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource TrafficLight}" Background="#FF5F57" Click="WindowClose_Click" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"/><Button Style="{StaticResource TrafficLight}" Background="#FEBC2E" Click="WindowMinimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/><Button Style="{StaticResource TrafficLight}" Background="#28C840" Click="WindowMaximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"/></StackPanel><TextBlock Text="Afterglow" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="Your music. Your atmosphere." HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
    <Grid Grid.Row="1" Margin="16,0,16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="266"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource SidebarBrush}" CornerRadius="14" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="13,20,13,16" Margin="0,0,18,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="AFTERGLOW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,13"/>
        <Button Content="⌂   Wallpaper studio" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource AccentBrush}" HorizontalContentAlignment="Left" FontWeight="SemiBold" Click="Studio_Click"/>
        <Button Content="◐   Appearance" Background="Transparent" HorizontalContentAlignment="Left" Click="Appearance_Click" Margin="0,5,0,0"/>
        <Button Content="♬   Mini-player" Background="Transparent" HorizontalContentAlignment="Left" Click="MiniPlayer_Click" Margin="0,5,0,0"/>
        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="7,22,7,18"/>
        <TextBlock Text="YOUR CONNECTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,9"/>
        <Button Content="◎   Connect music" Background="Transparent" HorizontalContentAlignment="Left" Click="Connect_Click"/>
        <Button Content="↗   YouTube Music" Background="Transparent" HorizontalContentAlignment="Left" Click="Music_Click" Margin="0,4,0,0"/>
        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="7,22,7,18"/>
        <TextBlock Text="A LOOK FOR EVERY ALBUM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,10"/>
        <Button Content="Ambient" Tag="Ambient" Click="Preset_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
        <Button Content="Gallery" Tag="Gallery" Click="Preset_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
        <Button Content="Immersive" Tag="Immersive" Click="Preset_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
        <Button Content="Backdrop" Tag="Backdrop" Click="Preset_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
       </StackPanel>
       <StackPanel Grid.Row="2" Margin="7,12,0,0"><TextBlock Text="YouTube Music" FontWeight="SemiBold"/><TextBlock x:Name="SidebarStatus" Text="Waiting for connection" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,14"/><TextBlock Text="AFTERGLOW  /  1.4" FontSize="9" Foreground="{DynamicResource FaintBrush}"/></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="0,2,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="20" Padding="13,2"><DockPanel><TextBlock Text="⌕" FontSize="21" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><Grid><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" KeyDown="Search_KeyDown" Padding="0,8" ToolTip="Search the YouTube Music website"/><TextBlock Text="Search songs, artists, or albums on YouTube Music" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
       <Button Grid.Column="1" x:Name="ConnectionButton" Content="Connect music" Click="Connect_Click" Margin="10,0,0,0" Padding="10,8" FontSize="10" Background="{DynamicResource SurfaceBrush}"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,7,4">
       <Grid Margin="0,2,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border CornerRadius="12" Width="152" Height="152" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True" HorizontalAlignment="Left"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity=".12"/></Border.Effect><local:CrossfadeView x:Name="HeroArt" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1" Margin="19,6,0,0"><TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HeroTitle" Text="Your music, in a new light." FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="77" TextTrimming="CharacterEllipsis" Margin="0,5,0,6"/><TextBlock x:Name="HeroArtist" Text="Connect YouTube Music" FontSize="14" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HeroAlbum" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Apply wallpaper" Click="Apply_Click" Background="{DynamicResource AccentBrush}" Foreground="White" Padding="15,7"/><Button Content="Export PNG" Click="Export_Click" Margin="8,0,0,0" Padding="13,7" Background="{DynamicResource SurfaceBrush}"/></StackPanel></StackPanel>
       </Grid>
       <Grid Margin="0,0,0,10"><TextBlock Text="Your desktop" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="PreviewLabel" Text="GALLERY" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></Grid>
       <Border Height="290" CornerRadius="14" Background="#241C25" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True"><Grid><Image Source="{Binding Source, ElementName=Atmosphere}" Stretch="UniformToFill" Opacity=".6" IsHitTestVisible="False"/><local:CrossfadeView x:Name="Preview" Stretch="Uniform" Height="290"/><Border Background="#AD17121A" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="9,5" Margin="12"><TextBlock Text="WALLPAPER PREVIEW" Foreground="#EEE9EF" FontSize="9"/></Border></Grid></Border>
       <Grid Margin="0,21,0,12"><TextBlock Text="Choose your atmosphere" FontSize="17" FontWeight="Bold"/><TextBlock Text="Made from your album artwork" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
       <UniformGrid Columns="4">
        <Button x:Name="AmbientButton" Tag="Ambient" Click="Preset_Click" Padding="7" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="AmbientThumb" Height="71" Stretch="UniformToFill"/><TextBlock Text="Ambient" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Color + cover" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
        <Button x:Name="GalleryButton" Tag="Gallery" Click="Preset_Click" Padding="7" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="GalleryThumb" Height="71" Stretch="UniformToFill"/><TextBlock Text="Gallery" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Centered artwork" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
        <Button x:Name="ImmersiveButton" Tag="Immersive" Click="Preset_Click" Padding="7" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="ImmersiveThumb" Height="71" Stretch="UniformToFill"/><TextBlock Text="Immersive" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Full-frame color" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
        <Button x:Name="BackdropButton" Tag="Backdrop" Click="Preset_Click" Padding="7" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="BackdropThumb" Height="71" Stretch="UniformToFill"/><TextBlock Text="Backdrop" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Just the colors" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
       </UniformGrid>
      </StackPanel></ScrollViewer>
     </Grid>
     <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="18,20,15,16">
      <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,0">
       <TextBlock Text="Make it yours" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="SettingsSaved" Text="Your choices are saved automatically" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,20"/>
       <Grid><TextBlock Text="Background softness"/><TextBlock x:Name="BlurValue" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="BlurSlider" ValueChanged="Appearance_Changed"/>
       <Grid><TextBlock Text="Dim the lights"/><TextBlock x:Name="DimValue" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="DimSlider" ValueChanged="Appearance_Changed"/>
       <Grid><TextBlock Text="Cover size"/><TextBlock x:Name="SizeValue" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="SizeSlider" Minimum="25" Maximum="80" ValueChanged="Appearance_Changed"/>
       <CheckBox x:Name="InfoCheck" Content="Show track and artist" Checked="Options_Changed" Unchecked="Options_Changed"/>
       <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,12,0,17"/><TextBlock Text="App appearance" FontWeight="SemiBold"/><ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed"><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
       <TextBlock Text="Wallpaper resolution"/><ComboBox x:Name="ResolutionBox" SelectionChanged="Resolution_Changed"><ComboBoxItem Content="Display"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="4K"/></ComboBox><TextBlock x:Name="ArtworkQuality" Text="Source artwork · waiting for music" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,-5,0,10"/>
       <CheckBox x:Name="FadeCheck" Content="Smooth song transitions" Checked="Fade_Changed" Unchecked="Fade_Changed"/><TextBlock Text="A smooth 2 second dissolve on your desktop." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/><Button Content="Test desktop fade" Click="TestFade_Click" FontSize="11" HorizontalAlignment="Left" Padding="10,6" Margin="0,3,0,10"/>
       <CheckBox x:Name="AutoCheck" Content="Follow the playing song" Checked="Options_Changed" Unchecked="Options_Changed"/><CheckBox x:Name="WidgetCheck" Content="Show mini-player" Checked="Options_Changed" Unchecked="Options_Changed"/>
       <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,12,0,12"/><CheckBox x:Name="RestoreCheck" Content="Restore wallpaper on exit" Checked="Options_Changed" Unchecked="Options_Changed"/><CheckBox x:Name="StartupCheck" Content="Start with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
       <Button Content="Restore original wallpaper" Click="Restore_Click" Background="Transparent" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Padding="0,8" Margin="0,5,0,0"/>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,13,22,11">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True" HorizontalAlignment="Left"><local:CrossfadeView x:Name="MiniArt" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="TrackTitle" Text="Your music, in a new light." FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackArtist" Text="Connect YouTube Music" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid>
      <StackPanel Grid.Column="1" Margin="12,-6,12,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PreviousButton" Content="⏮" Tag="previous" Click="Player_Click" Padding="13,5" Background="Transparent" ToolTip="Previous track"/><Button x:Name="PlayButton" Content="▶" Tag="toggle" Click="Player_Click" Width="34" Height="34" Padding="0" Background="{DynamicResource SurfaceBrush}" ToolTip="Play or pause"/><Button x:Name="NextButton" Content="⏭" Tag="next" Click="Player_Click" Padding="13,5" Background="Transparent" ToolTip="Next track"/></StackPanel><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedTime" Text="0:00" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="ProgressSlider" Minimum="0" Maximum="1" Margin="0" PreviewMouseLeftButtonUp="Seek_Released" ToolTip="Playback position"/><TextBlock Grid.Column="2" x:Name="TotalTime" Text="0:00" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock x:Name="Status" Text="Connect music to get started." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="34"/><TextBlock Text="Close to tray to keep the music in sync." Foreground="{DynamicResource FaintBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>


