<Window x:Class="Afterglow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Afterglow" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Afterglow" Icon="afterglow.ico" Width="1260" Height="860" MinWidth="920" MinHeight="660" WindowStyle="None" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen" PreviewKeyDown="Shell_KeyDown">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
<Border x:Name="StudioSurface" local:RoundClip.Radius="12" RenderTransformOrigin=".5,.5" CornerRadius="12" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
<Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
<Image x:Name="Atmosphere" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
<Border Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"><Grid Margin="14,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource TrafficLight}" Background="#FF5F57" Click="WindowClose_Click" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"/><Button Style="{StaticResource TrafficLight}" Background="#FEBC2E" Click="WindowMinimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/><Button Style="{StaticResource TrafficLight}" Background="#28C840" Click="WindowMaximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"/></StackPanel>
<Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Click="Sidebar_Click" ToolTip="Show or hide sidebar (Ctrl+B)" AutomationProperties.Name="Show or hide sidebar" shell:WindowChrome.IsHitTestVisibleInChrome="True"><local:Symbol Kind="sidebar"/></Button>
<TextBlock Grid.Column="2" x:Name="ToolbarTitle" Text="Wallpaper Studio" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="14,0"/>
<Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="9,0" Margin="0,8,8,8" shell:WindowChrome.IsHitTestVisibleInChrome="True"><DockPanel><local:Symbol Kind="search" Width="15" Height="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><Button DockPanel.Dock="Right" Width="24" Click="ClearSearch_Click" ToolTip="Clear search" AutomationProperties.Name="Clear search"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><local:Symbol Kind="close" Width="12" Height="12"/></Button><Grid><TextBox x:Name="SearchBox" KeyDown="Search_KeyDown" Padding="0,5" Background="Transparent" BorderThickness="0" FontSize="12" ToolTip="Search YouTube Music (Ctrl+F)" AutomationProperties.Name="Search YouTube Music"/><TextBlock Text="Search YouTube Music" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
<Button Grid.Column="4" x:Name="ConnectionButton" Content="Connect music" Click="Connect_Click" Style="{StaticResource ToolbarButton}" Padding="12,6" FontSize="12" ToolTip="Connection setup" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
</Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="SidebarShell" Width="204" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="12,22,12,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
<TextBlock x:Name="BrandLabel" Text="Afterglow" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,26"/>
<TextBlock x:Name="SectionLabel" Text="YOUR DESKTOP" Style="{StaticResource Caption}" Margin="10,0,0,8"/>
<Button x:Name="NavStudio" Tag="Studio" Click="Navigate_Click" Style="{StaticResource NavigationButton}" ToolTip="Wallpaper Studio" AutomationProperties.Name="Wallpaper Studio"><StackPanel Orientation="Horizontal"><local:Symbol Kind="wallpaper" Margin="0,0,12,0"/><TextBlock x:Name="LabelStudio" Text="Wallpaper Studio" FontSize="13" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="NavAppearance" Tag="Appearance" Click="Navigate_Click" Style="{StaticResource NavigationButton}" ToolTip="Appearance" AutomationProperties.Name="Appearance"><StackPanel Orientation="Horizontal"><local:Symbol Kind="appearance" Margin="0,0,12,0"/><TextBlock x:Name="LabelAppearance" Text="Appearance" FontSize="13" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="NavLyrics" Tag="Lyrics" Click="Navigate_Click" Style="{StaticResource NavigationButton}" ToolTip="Lyrics" AutomationProperties.Name="Lyrics"><StackPanel Orientation="Horizontal"><local:Symbol Kind="lyrics" Margin="0,0,12,0"/><TextBlock x:Name="LabelLyrics" Text="Lyrics" FontSize="13" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="NavPlayback" Tag="Playback" Click="Navigate_Click" Style="{StaticResource NavigationButton}" ToolTip="Playback" AutomationProperties.Name="Playback"><StackPanel Orientation="Horizontal"><local:Symbol Kind="controller" Margin="0,0,12,0"/><TextBlock x:Name="LabelPlayback" Text="Playback" FontSize="13" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="NavConnection" Tag="Connection" Click="Navigate_Click" Style="{StaticResource NavigationButton}" ToolTip="Connection" AutomationProperties.Name="Connection"><StackPanel Orientation="Horizontal"><local:Symbol Kind="connection" Margin="0,0,12,0"/><TextBlock x:Name="LabelConnection" Text="Connection" FontSize="13" VerticalAlignment="Center"/></StackPanel></Button>
<Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="10,20,10,14"/><Button Click="Music_Click" Style="{StaticResource NavigationButton}" ToolTip="Open YouTube Music" AutomationProperties.Name="Open YouTube Music"><StackPanel Orientation="Horizontal"><local:Symbol Kind="external" Margin="0,0,12,0"/><TextBlock x:Name="MusicLabel" Text="YouTube Music" FontSize="13"/></StackPanel></Button></StackPanel>
<StackPanel Grid.Row="2" Margin="10,0"><TextBlock x:Name="SidebarStatus" Text="Waiting for connection" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="VersionLabel" Text="Afterglow 2.1.1" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Grid></Border>
<Border Grid.Column="1" Background="{DynamicResource WindowBrush}"><Grid x:Name="PageHost" Margin="30,24,30,20">
<ScrollViewer x:Name="StudioPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
<TextBlock Text="Wallpaper Studio" Style="{StaticResource PageTitle}"/><TextBlock Text="A little atmosphere for whatever is playing." Style="{StaticResource Subtitle}" Margin="0,5,0,24"/>
<Border x:Name="ConnectionNotice" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,20"><DockPanel><Button DockPanel.Dock="Right" Content="Connect music" Click="Connect_Click" Style="{StaticResource SecondaryButton}"/><StackPanel><TextBlock Text="Bring YouTube Music to your desktop" FontWeight="SemiBold"/><TextBlock Text="Connect once. Your browser keeps your Google sign-in." Style="{StaticResource Caption}" Margin="0,4,16,0"/></StackPanel></DockPanel></Border>
<Grid x:Name="HeroSection" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:CrossfadeView x:Name="HeroArt" Width="124" Height="124" Stretch="UniformToFill" local:RoundClip.Radius="9" HorizontalAlignment="Left"/>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="HeroStateLabel" Text="STYLE PREVIEW" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="HeroTitle" Text="Your music, in a new light." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="78" TextTrimming="CharacterEllipsis" Margin="0,5,0,5"/><TextBlock x:Name="HeroArtist" Text="Connect YouTube Music" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><TextBlock x:Name="HeroAlbum" Style="{StaticResource Caption}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Apply wallpaper" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Export PNG" Click="Export_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/></StackPanel></StackPanel></Grid>
<Grid Margin="0,0,0,12"><TextBlock Text="Your desktop" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PreviewLabel" Text="Ambient" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
<Border Height="230" Background="#242429" CornerRadius="10" local:RoundClip.Radius="10"><Grid><Image Source="{Binding Source,ElementName=Atmosphere}" Stretch="UniformToFill" Opacity=".4"/><local:CrossfadeView x:Name="Preview" Stretch="Uniform" Height="230"/><Viewbox Stretch="Uniform" IsHitTestVisible="False"><Canvas Width="1280" Height="720"><local:LyricsView x:Name="LyricPreview" Canvas.Left="678.4" Canvas.Top="100.8" Width="486.4" Height="518.4" Visibility="Collapsed"/></Canvas></Viewbox></Grid></Border>
<Grid Margin="0,24,0,12"><TextBlock Text="Choose a style" Style="{StaticResource SectionTitle}"/><Button Content="Customize" Click="Appearance_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/></Grid>
<UniformGrid Columns="4">
        <Button x:Name="AmbientButton" Tag="Ambient" Click="Preset_Click" Style="{StaticResource ArtworkCard}" Padding="10" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="AmbientThumb" Height="80" Stretch="UniformToFill"/><TextBlock Text="Ambient" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Color + cover" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
        <Button x:Name="GalleryButton" Tag="Gallery" Click="Preset_Click" Style="{StaticResource ArtworkCard}" Padding="10" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="GalleryThumb" Height="80" Stretch="UniformToFill"/><TextBlock Text="Gallery" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Centered artwork" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
        <Button x:Name="ImmersiveButton" Tag="Immersive" Click="Preset_Click" Style="{StaticResource ArtworkCard}" Padding="10" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="ImmersiveThumb" Height="80" Stretch="UniformToFill"/><TextBlock Text="Immersive" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Full-frame color" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
        <Button x:Name="BackdropButton" Tag="Backdrop" Click="Preset_Click" Style="{StaticResource ArtworkCard}" Padding="10" HorizontalContentAlignment="Stretch"><StackPanel><Image x:Name="BackdropThumb" Height="80" Stretch="UniformToFill"/><TextBlock Text="Backdrop" FontWeight="SemiBold" Margin="2,8,0,3"/><TextBlock Text="Just the colors" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,1"/></StackPanel></Button>
       </UniformGrid></StackPanel></ScrollViewer>
<ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left" Width="{Binding ViewportWidth,ElementName=AppearancePage}">
<TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/><TextBlock Text="Shape the light, color, and artwork on your desktop." Style="{StaticResource Subtitle}" Margin="0,5,0,24"/>
<Border Style="{StaticResource SettingGroup}"><StackPanel><TextBlock Text="Wallpaper" Style="{StaticResource SectionTitle}" Margin="0,0,0,20"/>
<Grid><TextBlock Text="Background softness"/><TextBlock x:Name="BlurValue" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid><Slider x:Name="BlurSlider" ValueChanged="Appearance_Changed" AutomationProperties.Name="Background softness"/>
<Grid><TextBlock Text="Dim the lights"/><TextBlock x:Name="DimValue" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid><Slider x:Name="DimSlider" ValueChanged="Appearance_Changed" AutomationProperties.Name="Dim the lights"/>
<Grid><TextBlock Text="Cover size"/><TextBlock x:Name="SizeValue" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid><Slider x:Name="SizeSlider" Minimum="25" Maximum="80" ValueChanged="Appearance_Changed" AutomationProperties.Name="Cover size"/>
<CheckBox x:Name="InfoCheck" Content="Show track and artist" Checked="Options_Changed" Unchecked="Options_Changed"/>
<Separator/><TextBlock Text="Resolution" FontWeight="Medium" Margin="0,12,0,0"/><ComboBox x:Name="ResolutionBox" SelectionChanged="Resolution_Changed" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Wallpaper resolution"><ComboBoxItem Content="Display"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="4K"/></ComboBox><TextBlock x:Name="ArtworkQuality" Text="Source artwork: waiting for music" Style="{StaticResource Caption}"/></StackPanel></Border>
<Border Style="{StaticResource SettingGroup}"><StackPanel><TextBlock Text="App appearance" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="App appearance"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><TextBlock Text="System follows the Windows light or dark appearance." Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource SettingGroup}"><StackPanel><TextBlock Text="Transitions" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="FadeCheck" Content="Smooth song transitions" Checked="Fade_Changed" Unchecked="Fade_Changed"/><TextBlock Text="A two-second blend between wallpapers. Motion follows the Windows animation preference." Style="{StaticResource Caption}" TextWrapping="Wrap"/><Button Content="Test desktop fade" Click="TestFade_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="LyricsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="Lyrics" Style="{StaticResource PageTitle}"/><TextBlock Text="Follow the song, one line at a time." Style="{StaticResource Subtitle}" Margin="0,5,0,24"/>
<Border Background="#252529" CornerRadius="12" local:RoundClip.Radius="12" Height="390"><Grid><Image Source="{Binding Source,ElementName=Atmosphere}" Stretch="UniformToFill" Opacity=".40"/><Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width=".8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,28,0"><local:CrossfadeView x:Name="LyricsCover" Width="190" Height="190" Stretch="UniformToFill" local:RoundClip.Radius="9"/><TextBlock Text="{Binding Text,ElementName=HeroTitle}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,5"/><TextBlock Text="{Binding Text,ElementName=HeroArtist}" Foreground="#CCFFFFFF" FontSize="13"/></StackPanel><local:LyricsView x:Name="LyricsStage" Grid.Column="1"/><TextBlock x:Name="LyricsEmpty" Grid.Column="1" Text="Synced lyrics appear here when available." TextWrapping="Wrap" Foreground="#C8FFFFFF" VerticalAlignment="Center" FontSize="21"/></Grid></Grid></Border>
<Border Style="{StaticResource SettingGroup}" Margin="0,20,0,0"><StackPanel><CheckBox x:Name="LyricsCheck" Content="Show synced lyrics on the desktop" Checked="Lyrics_Changed" Unchecked="Lyrics_Changed"/><TextBlock x:Name="LyricsStatus" Text="Lyrics off" Style="{StaticResource Caption}" Margin="0,4,0,18"/><TextBlock Text="Timing adjustment" FontWeight="Medium"/><Slider x:Name="LyricsOffsetSlider" Minimum="-5" Maximum="5" TickFrequency=".25" IsSnapToTickEnabled="True" ValueChanged="LyricsOffset_Changed" AutomationProperties.Name="Lyrics timing adjustment"/><TextBlock x:Name="LyricsOffsetLabel" Text="0.00 s: positive advances lyrics" Style="{StaticResource Caption}"/><Separator Margin="0,18"/><TextBlock Text="Lyrics use LRCLIB. When enabled, song title, artist, album, and duration are sent to that service. Coverage and recording timing can vary." Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer x:Name="PlaybackPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left" Width="{Binding ViewportWidth,ElementName=PlaybackPage}"><TextBlock Text="Playback" Style="{StaticResource PageTitle}"/><TextBlock Text="Keep the music and your desktop in step." Style="{StaticResource Subtitle}" Margin="0,5,0,24"/><Border Style="{StaticResource SettingGroup}"><StackPanel><TextBlock Text="Automation" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AutoCheck" Content="Follow the playing song" Checked="Options_Changed" Unchecked="Options_Changed"/><TextBlock Text="Update the wallpaper when YouTube Music changes songs." Style="{StaticResource Caption}"/><CheckBox x:Name="RestoreCheck" Content="Restore my wallpaper when Afterglow exits" Checked="Options_Changed" Unchecked="Options_Changed"/><CheckBox x:Name="StartupCheck" Content="Start with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed"/></StackPanel></Border><Border Style="{StaticResource SettingGroup}"><StackPanel><TextBlock Text="Mini-player" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="WidgetCheck" Content="Show the floating playback controller" Checked="Options_Changed" Unchecked="Options_Changed"/><TextBlock Text="Move it anywhere, or pin it above other windows. Your position is remembered." Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource SettingGroup}"><StackPanel><TextBlock Text="Original wallpaper" Style="{StaticResource SectionTitle}"/><TextBlock Text="Return to the wallpaper saved before Afterglow took over." Style="{StaticResource Caption}" Margin="0,8,0,14"/><Button Content="Restore original wallpaper" Click="Restore_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left" Width="{Binding ViewportWidth,ElementName=ConnectionPage}"><TextBlock Text="Connection" Style="{StaticResource PageTitle}"/><TextBlock Text="High-quality artwork, straight from YouTube Music." Style="{StaticResource Subtitle}" Margin="0,5,0,24"/><Border Style="{StaticResource SettingGroup}"><StackPanel><local:Symbol Kind="connection" Width="32" Height="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Text,ElementName=SidebarStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock Text="Afterglow connects to a browser extension on this PC. Google sign-in stays in your browser, and the app only accepts YouTube Music artwork." Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,0,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Set up connection" Click="Connect_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Open YouTube Music" Click="Music_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border><TextBlock Text="The setup guide prepares a private, pre-paired extension folder for this PC. After an extension update, reload it in your browser's Extensions page and refresh the music tab." Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,12,0,20"/><TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ctrl+1-5   Navigate views&#10;Ctrl+B       Show or hide sidebar&#10;Ctrl+F       Search YouTube Music&#10;Ctrl+Shift+M   Show mini-player&#10;Ctrl+,        Appearance" Style="{StaticResource Subtitle}" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
</Grid></Border></Grid>
<Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:CrossfadeView x:Name="MiniArt" Width="44" Height="44" Stretch="UniformToFill" local:RoundClip.Radius="6"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="TrackTitle" Text="Nothing playing yet" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackArtist" Text="YouTube Music" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid><StackPanel Grid.Column="1" Margin="16,-4,16,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PreviousButton" Tag="previous" Click="Player_Click" Style="{StaticResource ToolbarButton}" ToolTip="Previous track" AutomationProperties.Name="Previous track"><local:Symbol Kind="previous" Width="17" Height="17"/></Button><Button x:Name="PlayButton" Tag="toggle" Click="Player_Click" Style="{StaticResource ToolbarButton}" ToolTip="Play or pause" AutomationProperties.Name="Play or pause"><local:Symbol x:Name="PlayGlyph" Kind="play" Width="23" Height="23"/></Button><Button x:Name="NextButton" Tag="next" Click="Player_Click" Style="{StaticResource ToolbarButton}" ToolTip="Next track" AutomationProperties.Name="Next track"><local:Symbol Kind="next" Width="17" Height="17"/></Button></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedTime" Text="0:00" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="ProgressSlider" Minimum="0" Maximum="1" Margin="0" PreviewMouseLeftButtonUp="Seek_Released" AutomationProperties.Name="Playback position" SmallChange=".01" LargeChange=".05" PreviewKeyUp="Seek_KeyUp"/><TextBlock Grid.Column="2" x:Name="TotalTime" Text="0:00" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel><Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="12,0"><TextBlock x:Name="Status" Text="Connect music to get started." Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="30"/><TextBlock x:Name="SettingsSaved" Text="Changes save automatically" Style="{StaticResource Caption}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Click="MiniPlayer_Click" Style="{StaticResource ToolbarButton}" ToolTip="Show mini-player" AutomationProperties.Name="Show mini-player"><local:Symbol Kind="controller"/></Button></Grid></Grid></Border>
</Grid></Border></Window>
