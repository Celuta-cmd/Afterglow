<?xml version='1.0' encoding='utf-8'?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Afterglow" Manufacturer="Afterglow contributors" Version="$(var.ProductVersion)" UpgradeCode="018E9D01-E203-4E8F-8F95-CA7B687199AA" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Afterglow is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPPRODUCTICON" Value="AfterglowIcon" />
    <Property Id="SAVEDINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="RememberInstallLocation" Root="HKCU" Key="Software\Afterglow\Installer" Name="InstallPath" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[SAVEDINSTALLFOLDER]" Before="CostFinalize" Sequence="both" Condition="SAVEDINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <Icon Id="AfterglowIcon" SourceFile="$(var.ProjectDir)/src/Afterglow/afterglow.ico" />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 17763)" Message="Afterglow requires 64-bit Windows 10 version 1809 or later." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Afterglow">
          <Component Id="C355da78b47f6dbd17d" Guid="08ea3b87-c1e5-5852-ba1f-edc408f9a1b2" Bitness="always64">
            <File Id="AfterglowExe" Source="$(var.PayloadDir)/Afterglow.exe" Name="Afterglow.exe" />
