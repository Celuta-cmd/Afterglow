          <Directory Id="Dd3fa2adc37ff95ea54" Name="third-party">
            <Component Id="C9fec160e834aaacfe4" Guid="5fa79d89-7088-585a-a67c-abf57a5fddbf" Bitness="always64">
              <File Id="F9fec160e834aaacfe4" Source="$(var.PayloadDir)/third-party/aspnetcore-NOTICES.txt" Name="aspnetcore-NOTICES.txt" />
              <RegistryValue Root="HKCU" Key="Software\Afterglow\Installer" Name="C9fec160e834aaacfe4" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
            </Component>
            <Component Id="C2cee9466e396c8c862" Guid="58543a4a-7507-5e6b-8960-ec1b7c4b5db8" Bitness="always64">
