    </Feature>
    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <Component Id="DirectoryCleanup" Guid="5c0b7977-8960-5b24-a14d-471c8861fb18" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Afterglow\Installer" Name="Directories" Value="1" Type="integer" KeyPath="yes" />
      <RemoveFolder Id="CleanDirectory0" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="CleanDirectory1" Directory="D26f1de33979d065ba8" On="uninstall" />
      <RemoveFolder Id="CleanDirectory2" Directory="Dd3fa2adc37ff95ea54" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Afterglow\Installer" Name="InstallPath" Value="[INSTALLFOLDER]" Type="string" />
    </Component>
    <Component Id="MenuShortcut" Guid="*" Directory="AfterglowMenu">
      <Shortcut Id="MenuShortcutLink" Name="Afterglow" Target="[#AfterglowExe]" WorkingDirectory="INSTALLFOLDER" Icon="AfterglowIcon" Description="YouTube Music wallpapers and synced lyrics" />
      <RegistryValue Root="HKCU" Key="Software\Afterglow\Installer" Name="MenuShortcut" Value="1" Type="integer" KeyPath="yes" />
      <RemoveFolder Id="RemoveMenu" On="uninstall" />
    </Component>
    <Component Id="DesktopShortcut" Guid="*" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcutLink" Name="Afterglow Studio" Target="[#AfterglowExe]" WorkingDirectory="INSTALLFOLDER" Icon="AfterglowIcon" Description="YouTube Music wallpapers and synced lyrics" />
      <RegistryValue Root="HKCU" Key="Software\Afterglow\Installer" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
    <CustomAction Id="CleanupAfterglow" FileRef="AfterglowExe" ExeCommand="--installer-cleanup" Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="ExitForUpgrade" FileRef="AfterglowExe" ExeCommand="--request-exit" Execute="immediate" Return="ignore" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="CleanupAfterglow" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ExitForUpgrade" Before="CleanupAfterglow" Condition="REMOVE=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Afterglow and set up your browser" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchAfterglow" FileRef="AfterglowExe" ExeCommand="" Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAfterglow" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.ProjectDir)/installer/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.ProjectDir)/installer/dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)/installer/license.rtf" />
